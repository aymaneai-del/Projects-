{%- comment -%}
  KLAXO — « Pourquoi Klaxo ». Trois différenciateurs, pas une liste de features.
{%- endcomment -%}

<section class="klaxo klaxo-features">
  <div class="klaxo-container">
    <div class="klaxo-features__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="klaxo-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="klaxo-title">{{ section.settings.title }}</h2>
    </div>

    <div class="klaxo-features__grid">
      {%- for block in section.blocks -%}
        <div class="klaxo-feature" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="klaxo-feature__media">
              {{
                block.settings.image
                | image_url: width: 560
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 900px) 360px, 92vw',
                  widths: '300, 460, 560',
                  alt: block.settings.image.alt | default: block.settings.title
              }}
            </div>
          {%- else -%}
            <span class="klaxo-feature__icon">
              {%- render 'klaxo-icon', name: block.settings.icon, size: 24 -%}
            </span>
          {%- endif -%}
          <h3 class="klaxo-feature__title">{{ block.settings.title }}</h3>
          <p class="klaxo-feature__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KLAXO — Pourquoi",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Pourquoi KLAXO" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Ce qu'on fait différemment" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Point fort",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Si vide, l'icône ci-dessous est utilisée." },
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "shield", "label": "Garantie" },
            { "value": "cash", "label": "Paiement" },
            { "value": "truck", "label": "Livraison" },
            { "value": "return", "label": "Retour" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [{ "name": "KLAXO — Pourquoi" }]
}
{% endschema %}
