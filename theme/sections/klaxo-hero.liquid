{%- comment -%}
  KLAXO — hero de la page d'accueil, centré sur UN produit.

  Le premier écran mobile doit montrer, sans défiler : le produit, son prix,
  et un bouton qui mène au formulaire. Un hero « de marque » (slogan + photo
  d'ambiance) fait défiler deux écrans avant le premier prix : chaque écran
  perdu est une part du trafic payant qui repart.

  Une seule promesse de réassurance, en ligne compacte sous le bouton. La
  barre d'annonce la porte déjà : la répéter en grosses cartes repousse le
  produit vers le bas sans rien ajouter.

  Prix barré : affiché UNIQUEMENT s'il est saisi dans Shopify (« Prix avant
  réduction » de la variante). Le thème n'en invente jamais : un faux prix
  barré est une pratique commerciale trompeuse, et le client qui la découvre
  refuse le colis.
{%- endcomment -%}

{%- assign produit = section.settings.product -%}
{%- if produit != blank -%}
  {%- assign variante = produit.selected_or_first_available_variant -%}
  {%- assign lien = produit.url -%}
{%- else -%}
  {%- assign lien = section.settings.cta_url -%}
{%- endif -%}

<section class="klaxo klaxo-hero" aria-labelledby="klaxo-hero-title-{{ section.id }}">
  <div class="klaxo-container klaxo-hero__inner">
    <div class="klaxo-hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <span class="klaxo-hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 id="klaxo-hero-title-{{ section.id }}" class="klaxo-title klaxo-hero__title">
        {{ section.settings.title }}
        {%- if section.settings.title_accent != blank %}
          <span class="klaxo-hero__accent">{{ section.settings.title_accent }}</span>
        {%- endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="klaxo-hero__lede">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    {%- comment -%}
      Ordre du DOM = ordre mobile : texte, visuel, prix + bouton. En desktop,
      la grille place le visuel à droite sur toute la hauteur.
    {%- endcomment -%}
    <div class="klaxo-hero__media">
      {%- if section.settings.video != blank -%}
        {%- comment -%}
          Vidéo muette en boucle : montrer le produit utilisé vend mieux qu'une
          animation. preload="metadata" + poster : l'image d'aperçu est l'élément
          LCP, la vidéo arrive ensuite sans bloquer l'affichage.
        {%- endcomment -%}
        {{
          section.settings.video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            controls: false,
            preload: 'metadata',
            image_size: '900x',
            class: 'klaxo-hero__video'
        }}
      {%- elsif section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 900
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 900px) 480px, 92vw',
            widths: '440, 660, 900',
            alt: section.settings.image.alt | default: section.settings.title
        }}
      {%- elsif produit.featured_media != blank -%}
        {{
          produit.featured_media
          | image_url: width: 900
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 900px) 480px, 92vw',
            widths: '440, 660, 900',
            alt: produit.featured_media.alt | default: produit.title
        }}
      {%- else -%}
        <span class="klaxo-hero__placeholder" aria-hidden="true">
          {%- render 'klaxo-icon', name: 'truck', size: 56 -%}
        </span>
      {%- endif -%}

      {%- if section.settings.badge != blank -%}
        <span class="klaxo-hero__badge">{{ section.settings.badge }}</span>
      {%- endif -%}
    </div>

    <div class="klaxo-hero__buy">
      {%- if produit != blank -%}
        <p class="klaxo-hero__product">{{ produit.title }}</p>
        <p class="klaxo-hero__price">
          {%- if produit.price_varies -%}
            <span class="klaxo-hero__from">dès</span>
          {%- endif -%}
          <span class="klaxo-hero__amount">{{ produit.price | money_without_trailing_zeros }}</span>
          {%- if variante.compare_at_price > variante.price -%}
            <s class="klaxo-hero__was">
              <span class="klaxo-visually-hidden">au lieu de</span>
              {{ variante.compare_at_price | money_without_trailing_zeros }}
            </s>
            {%- assign economie = variante.compare_at_price | minus: variante.price -%}
            <span class="klaxo-hero__save">−{{ economie | money_without_trailing_zeros }}</span>
          {%- endif -%}
        </p>
        {%- if section.settings.price_note != blank -%}
          <p class="klaxo-hero__pricenote">{{ section.settings.price_note }}</p>
        {%- endif -%}
      {%- endif -%}

      {%- if lien != blank -%}
        <a href="{{ lien }}" class="klaxo-btn klaxo-btn--primary klaxo-btn--shine klaxo-hero__cta">
          {{ section.settings.cta_label | default: 'Commander' }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="klaxo-hero__trust">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- render 'klaxo-icon', name: block.settings.icon, size: 16 -%}
              <span>{{ block.settings.title }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.secondary_label != blank and section.settings.secondary_url != blank -%}
        <a href="{{ section.settings.secondary_url }}" class="klaxo-hero__more">
          {{ section.settings.secondary_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KLAXO — Hero",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit mis en avant",
      "info": "Ton best-seller. Le prix, le lien du bouton et l'image par défaut viennent de ce produit."
    },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Le plus commandé" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Fini le bazar" },
    { "type": "text", "id": "title_accent", "label": "Fin du titre (en jaune)", "default": "entre les sièges." },
    {
      "type": "text",
      "id": "text",
      "label": "Texte court",
      "info": "Une phrase. Le bénéfice, pas la marque.",
      "default": "Téléphone, papiers, bouteille : tout à portée de main, plus rien qui tombe sous le siège."
    },

    { "type": "header", "content": "Visuel" },
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo du produit (recommandé)",
      "info": "5 à 8 secondes, le produit en situation dans une voiture, sans texte ni musique. Format vertical ou carré."
    },
    { "type": "image_picker", "id": "image", "label": "Image (si pas de vidéo)", "info": "Vide : la photo principale du produit est utilisée." },
    { "type": "text", "id": "badge", "label": "Pastille sur le visuel", "default": "Livraison incluse" },

    { "type": "header", "content": "Prix et bouton" },
    { "type": "text", "id": "price_note", "label": "Mention sous le prix", "default": "Tu payes au livreur, à la réception." },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Commander maintenant" },
    { "type": "url", "id": "cta_url", "label": "Lien du bouton (si aucun produit choisi)" },
    { "type": "text", "id": "secondary_label", "label": "Lien secondaire", "default": "Voir tous les produits" },
    { "type": "url", "id": "secondary_url", "label": "Lien secondaire — destination", "default": "/collections/all" }
  ],
  "blocks": [
    {
      "type": "reassurance",
      "name": "Réassurance",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "cash", "label": "Paiement" },
            { "value": "truck", "label": "Livraison" },
            { "value": "return", "label": "Retour" },
            { "value": "shield", "label": "Garantie" }
          ],
          "default": "cash"
        },
        { "type": "text", "id": "title", "label": "Texte court", "default": "Paiement à la livraison" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KLAXO — Hero",
      "blocks": [
        { "type": "reassurance", "settings": { "icon": "cash", "title": "Paiement à la livraison" } },
        { "type": "reassurance", "settings": { "icon": "truck", "title": "24-72 h" } },
        { "type": "reassurance", "settings": { "icon": "return", "title": "Échange 7 jours" } }
      ]
    }
  ]
}
{% endschema %}
