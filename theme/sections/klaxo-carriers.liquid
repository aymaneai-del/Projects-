{%- comment -%}
  KLAXO — partenaires logistiques.

  Noms, taux et zones sont TOUS des réglages, aucun n'est écrit dans le code :
  ces chiffres t'engagent vis-à-vis du client et doivent pouvoir être corrigés
  en dix secondes le jour où un contrat change ou où un taux évolue.

  N'affiche que les transporteurs saisis. Aucun bloc = section masquée.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <section class="klaxo klaxo-carriers">
    <div class="klaxo-container">
      <div class="klaxo-carriers__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="klaxo-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="klaxo-title">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="klaxo-lede">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <div class="klaxo-carriers__grid">
        {%- for block in section.blocks -%}
          <div class="klaxo-carrier" {{ block.shopify_attributes }}>
            <div class="klaxo-carrier__top">
              <span class="klaxo-carrier__name">{{ block.settings.name }}</span>
              {%- if block.settings.zone != blank -%}
                <span class="klaxo-carrier__zone">{{ block.settings.zone }}</span>
              {%- endif -%}
            </div>

            {%- if block.settings.rate != blank -%}
              <p class="klaxo-carrier__rate">
                <span class="klaxo-carrier__rate-num">{{ block.settings.rate }}</span>
                <span class="klaxo-carrier__rate-label">{{ block.settings.rate_label }}</span>
              </p>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="klaxo-carrier__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.note != blank -%}
        <p class="klaxo-carriers__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "KLAXO — Transporteurs",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Nos partenaires logistiques" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Des transporteurs fiables au Maroc" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduction",
      "default": "On répartit les livraisons selon la zone, pour que chaque colis parte avec le transporteur le plus rapide sur son secteur."
    },
    { "type": "text", "id": "note", "label": "Mention sous la grille" }
  ],
  "blocks": [
    {
      "type": "carrier",
      "name": "Transporteur",
      "settings": [
        {
          "type": "paragraph",
          "content": "Les taux affichés sont publics : ils engagent la boutique. Mets à jour ces chiffres depuis tes propres relevés de livraison, et retire-les si tu ne peux pas les justifier."
        },
        { "type": "text", "id": "name", "label": "Nom" },
        { "type": "text", "id": "zone", "label": "Étiquette de zone" },
        { "type": "text", "id": "rate", "label": "Taux affiché", "info": "Ex. 88 %. Laisse vide pour ne rien afficher." },
        { "type": "text", "id": "rate_label", "label": "Légende du taux", "default": "de livraison" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [{ "name": "KLAXO — Transporteurs" }]
}
{% endschema %}
